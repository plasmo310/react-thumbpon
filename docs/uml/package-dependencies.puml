@startuml package-dependencies
' サムネぽん / ThumbPon — パッケージ単位の依存関係
' src/ 配下の import から抽出したもの。さらに粗い全体像は layers.puml を参照
' エイリアスに header / storage / node などの PlantUML 予約語を使わないこと
' （行頭に来るとコマンドとして解釈され、その依存が黙って消える）

title サムネぽん / ThumbPon — パッケージ依存関係

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Hiragino Sans"
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 55
skinparam ArrowColor #9AA1A9
skinparam ArrowFontColor #7A8088
skinparam package {
  BorderColor #B9C0C8
  BackgroundColor #FAFBFC
  FontColor #25282D
  FontStyle bold
}
skinparam rectangle {
  BorderColor #7A8088
  BackgroundColor #FFFFFF
  FontColor #25282D
}

package "app" {
  rectangle "App.tsx / main.tsx\nshortcuts.ts" as cApp #FFF1EB
}

package "features" {
  rectangle "thumbnail" as fThumbnail
  rectangle "layer" as fLayer
  rectangle "canvas" as fCanvas
  rectangle "asset" as fAsset
  rectangle "project" as fProject
}

package "shared" {
  rectangle "ui\n表示専用の部品\nPanel / Button / Row / SliderRow ...\nEffectsSection / PresetRow" as sUi
  rectangle "lib\ncx / pointerDrag / dnd / notify\ndownload / layerRect / surfaceRef\nuseDropTarget / useAsyncAction" as sLib
}

package "core" {
  rectangle "store\nuseEditorStore / patch\n8つの slice" as cStore
  rectangle "storage\ndb / assetRepo / fontRepo\nfsAccess / panelLayout" as cStorage
  rectangle "model\ntypes / factory / geometry\nsnap / style / project" as cModel #F5F6F8
}

' --- app が組み立てる ---
cApp -down-> fThumbnail
cApp -down-> fLayer
cApp -down-> fCanvas
cApp -down-> fAsset
cApp -down-> fProject
cApp -down-> sUi : Splitter

' --- features -> shared ---
fThumbnail -down-> sUi
fLayer -down-> sUi
fCanvas -down-> sLib
fAsset -down-> sUi
fProject -down-> sUi
fThumbnail -down-> sLib
fLayer -down-> sLib
fAsset -down-> sLib
fProject -down-> sLib

' --- features -> core ---
fThumbnail -down-> cStore
fLayer -down-> cStore
fCanvas -down-> cStore
fAsset -down-> cStore
fProject -down-> cStore
fCanvas -down-> cModel
fLayer -down-> cModel
fProject -down-> cModel
fCanvas -down-> cStorage
fAsset -down-> cStorage
fLayer -down-> cStorage
fProject -down-> cStorage

' --- shared -> core ---
sUi -down-> cModel : 型だけ
sLib -down-> cModel

' --- core の中 ---
cStore -down-> cStorage
cStore -down-> cModel
cStorage -down-> cModel

legend left
  **features 同士に矢印は無い。** 共有が要るものは shared か core へ下ろす。
  ====
  **canvas -> project**（PNG書き出し対象の登録）は **shared/lib/surfaceRef** 経由。
  canvas が set、project が get で、直接は呼び合わない
  **shared/ui** はストアに触らない。値と更新関数を props で受けるだけ
  **core/model** は core の外を import しない。node でそのままテストできる
  **store は feature に分けない。** 8つの slice は1つのオブジェクトを意図的に共有し、
  互いの state を書く（単一ドキュメントを全機能で編集するエディタとして正しい形）
endlegend

@enduml
